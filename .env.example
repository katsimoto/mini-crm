# All VITE_* values are public and can be read in the browser bundle.
# Never put service_role, sb_secret_*, database passwords or user passwords here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_public_key
# A legacy anon JWT is also accepted in the field above. Never use a service_role JWT.
